<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMART TV LAUNCHER"
        android:textColor="#3B82F6"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pareamento de Dispositivo"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Acesse o Painel Web Administrativo e informe o código abaixo para vincular esta TV:"
        android:textColor="#9CA3AF"
        android:textSize="18sp" />

    <!-- Código PIN Grande em Destaque -->
    <TextView
        android:id="@+id/tvPairingCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_pin_box"
        android:paddingHorizontal="48dp"
        android:paddingVertical="20dp"
        android:text="--- ---"
        android:textColor="#FFFFFF"
        android:textSize="54sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/tvPairingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Aguardando confirmação no painel..."
        android:textColor="#60A5FA"
        android:textSize="16sp" />

</LinearLayout>
