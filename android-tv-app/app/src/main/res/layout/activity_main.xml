<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E">

    <!-- Player de Vídeo em Tela Cheia (ExoPlayer) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="zoom" />

    <!-- Gradiente Escuro de Fundo para Leitura -->
    <View
        android:id="@+id/viewScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_overlay" />

    <!-- Cabeçalho Superior: Título, Relógio e Wi-Fi -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="32dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seja Bem-vindo(a)!"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="10" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aproveite o melhor do entretenimento."
                android:textColor="#D1D5DB"
                android:textSize="18sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8" />
        </LinearLayout>

        <!-- Relógio Digital -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_clock_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="12:00"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Card de Wi-Fi -->
        <LinearLayout
            android:id="@+id/cardWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_wifi_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWifiSsid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Hotel"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWifiPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senha: hotel"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dock Inferior com Atalhos e Sky HDMI -->
    <LinearLayout
        android:id="@+id/layoutDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANAIS &amp; APLICATIVOS"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerShortcuts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- OVERLAY DE PAREAMENTO E AJUSTES DA TV (Acionado se não pareado ou via tecla MENU) -->
    <LinearLayout
        android:id="@+id/layoutPairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#07090E"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <!-- Barra Superior do Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMART TV MANAGER"
                android:textColor="#3B82F6"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvOverlaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_clock_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="v1.0.1"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status de Conexão com o Servidor -->
            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wifi_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="● Conectado ao Servidor (192.168.168.27)"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MODO 1: TELA DE PAREAMENTO INICIAL (Exibido se a TV NÃO estiver pareada) -->
        <LinearLayout
            android:id="@+id/panelPairingUnpaired"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Coluna 1: Pareamento via Painel Web com PIN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPÇÃO 1: PAREAR PELO PAINEL WEB"
                    android:textColor="#38BDF8"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No computador ou celular, abra http://192.168.168.27/ e clique no botão 'Parear com PIN':"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPairingCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pin_box"
                    android:gravity="center"
                    android:letterSpacing="0.15"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="18dp"
                    android:text="--- ---"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPairingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Aguardando confirmação no painel web..."
                    android:textColor="#60A5FA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDeviceIdInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ID deste Dispositivo: TV-..."
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Coluna 2: Seleção Direta de Quarto pelo Controle Remoto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPÇÃO 2: VINCULAR DIRETAMENTE NO CONTROLE"
                    android:textColor="#34D399"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Selecione o Quarto / Local desta TV na lista e pressione OK:"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/containerAvailableTvs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>

        <!-- MODO 2: AJUSTES DA TV VIA CONTROLE REMOTO (Exibido ao pressionar MENU se a TV já estiver pareada) -->
        <LinearLayout
            android:id="@+id/panelPairingSettings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Coluna Esquerda: Ajuste da Entrada HDMI -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAÍDA / ENTRADA HDMI (SKY TV)"
                    android:textColor="#EF4444"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvCurrentHdmiState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Porta Selecionada: HDMI 1"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Selecione onde o decodificador está conectado nesta TV:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- Grid de Chips HDMI Selecionáveis via Controle Remoto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnHdmi1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_chip_button"
                        android:text="Porta HDMI 1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnHdmi2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_chip_button"
                        android:text="Porta HDMI 2"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnHdmi3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_chip_button"
                        android:text="Porta HDMI 3"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnHdmiNone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_button"
                        android:text="Sem HDMI (Ocultar botão Sky nesta TV)"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Botão para Desvincular / Trocar de Quarto -->
                <Button
                    android:id="@+id/btnSettingsSwitchRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_button"
                    android:text="🔄 Trocar Quarto desta TV"
                    android:textColor="#F59E0B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Coluna Direita: Aplicativos Visíveis na Barra -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APLICATIVOS ATIVOS NA BARRA"
                    android:textColor="#60A5FA"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pressione OK em um app para ligar ou desligar da barra:"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="14dp"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/containerSettingsApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <!-- Botão de Concluir e Voltar -->
                <Button
                    android:id="@+id/btnSettingsDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_shortcut_sky"
                    android:paddingVertical="14dp"
                    android:text="✔️ Concluir e Voltar ao Vídeo"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Rodapé com Dica de Uso -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="Dica: Durante a reprodução, pressione a tecla MENU do controle para abrir este painel a qualquer momento."
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
